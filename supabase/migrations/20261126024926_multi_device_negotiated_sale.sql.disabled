begin;

-- Add a negotiated-price overload while preserving the existing 2-argument RPC.
create or replace function public.add_sale_item(
  p_sale_id uuid,
  p_device_id uuid,
  p_unit_price_pesewas bigint
)
returns table (
  result text,
  sale_id uuid,
  sale_item_id uuid,
  subtotal_pesewas bigint,
  discount_pesewas bigint,
  total_pesewas bigint
)
language plpgsql
security definer
set search_path = ''
as $$
declare
  add_result record;
  sale_record public.sales%rowtype;
  item_record public.sale_items%rowtype;
  caller_user_id uuid := auth.uid();
  caller_membership_id uuid;
  observed_at timestamptz := clock_timestamp();
begin
  if p_unit_price_pesewas is null or p_unit_price_pesewas <= 0 then
    raise exception using errcode = '22023',
      message = 'selling price must be greater than zero';
  end if;

  select *
    into add_result
    from public.add_sale_item(p_sale_id, p_device_id);

  if add_result.result <> 'added' then
    return query
      select add_result.result::text,
             add_result.sale_id::uuid,
             add_result.sale_item_id::uuid,
             add_result.subtotal_pesewas::bigint,
             add_result.discount_pesewas::bigint,
             add_result.total_pesewas::bigint;
    return;
  end if;

  select *
    into sale_record
    from public.sales
   where id = p_sale_id
   for update;

  if not found then
    raise exception using errcode = 'P0002',
      message = 'sale not found';
  end if;

  caller_membership_id :=
    private.sale_actor_membership(sale_record.store_id, 'create_sales');

  if caller_user_id is null or caller_membership_id is null then
    raise exception using errcode = '42501',
      message = 'not authorized to set sale item price';
  end if;

  select *
    into item_record
    from public.sale_items
   where id = add_result.sale_item_id
     and sale_id = p_sale_id
   for update;

  if not found or item_record.status <> 'active' then
    raise exception using errcode = '23514',
      message = 'active sale item not found';
  end if;

  update public.sale_items
     set unit_price_pesewas = p_unit_price_pesewas
   where id = item_record.id;

  perform private.recalculate_sale_totals(p_sale_id);

  insert into public.audit_events (
    store_id,
    actor_membership_id,
    event_type,
    entity_type,
    entity_id,
    event_data,
    occurred_at
  )
  values (
    sale_record.store_id,
    caller_membership_id,
    'sale.item_price_negotiated',
    'sale_item',
    item_record.id,
    jsonb_build_object(
      'sale_id', p_sale_id,
      'device_id', p_device_id,
      'unit_price_pesewas', p_unit_price_pesewas
    ),
    observed_at
  );

  return query
    select 'added'::text,
           p_sale_id,
           item_record.id,
           sale.subtotal_pesewas,
           sale.discount_pesewas,
           sale.total_pesewas
      from public.sales sale
     where sale.id = p_sale_id;
end;
$$;

revoke all on function public.add_sale_item(uuid, uuid, bigint)
  from public, anon, authenticated, service_role;
grant execute on function public.add_sale_item(uuid, uuid, bigint)
  to authenticated;


-- Complete every active item in a sale with one payment.
create or replace function public.confirm_sale_payment(
  p_sale_id uuid,
  p_payment_method text,
  p_reference text default null,
  p_notes text default null
)
returns table (
  sale_id uuid,
  payment_id uuid,
  total_pesewas bigint,
  status text
)
language plpgsql
security definer
set search_path = ''
as $$
declare
  sale_record public.sales%rowtype;
  item_record public.sale_items%rowtype;
  inventory_record public.store_inventory%rowtype;
  reservation_record public.inventory_reservations%rowtype;
  caller_user_id uuid := auth.uid();
  caller_membership_id uuid;
  active_item_count integer;
  new_payment_id uuid;
  observed_at timestamptz := clock_timestamp();
begin
  select *
    into sale_record
    from public.sales
   where id = p_sale_id
   for update;

  if not found then
    raise exception using errcode = 'P0002',
      message = 'sale not found';
  end if;

  caller_membership_id :=
    private.sale_actor_membership(sale_record.store_id, 'create_sales');

  if caller_user_id is null or caller_membership_id is null then
    raise exception using errcode = '42501',
      message = 'not authorized to confirm this sale';
  end if;

  if sale_record.status <> 'pending_payment' then
    raise exception using errcode = '23514',
      message = 'sale is not awaiting payment';
  end if;

  if p_payment_method not in ('cash', 'mobile_money', 'bank_transfer', 'card') then
    raise exception using errcode = '22023',
      message = 'invalid payment method';
  end if;

  select count(*)::integer
    into active_item_count
    from public.sale_items
   where sale_id = p_sale_id
     and status = 'active';

  if active_item_count < 1 then
    raise exception using errcode = '23514',
      message = 'sale requires at least one active device';
  end if;

  if sale_record.total_pesewas <= 0 then
    raise exception using errcode = '23514',
      message = 'sale total must be greater than zero';
  end if;

  insert into public.sale_payments (
    sale_id,
    store_id,
    amount_pesewas,
    payment_method,
    reference,
    notes,
    status,
    received_by_membership_id,
    received_at
  )
  values (
    p_sale_id,
    sale_record.store_id,
    sale_record.total_pesewas,
    p_payment_method,
    nullif(btrim(p_reference), ''),
    nullif(btrim(p_notes), ''),
    'confirmed',
    caller_membership_id,
    observed_at
  )
  returning id into new_payment_id;

  for item_record in
    select *
      from public.sale_items
     where sale_id = p_sale_id
       and status = 'active'
     order by created_at, id
     for update
  loop
    select *
      into inventory_record
      from public.store_inventory
     where id = item_record.inventory_id
     for update;

    if not found
       or inventory_record.store_id <> sale_record.store_id
       or inventory_record.status <> 'reserved' then
      raise exception using errcode = '23514',
        message = 'a sale device is no longer reserved';
    end if;

    select *
      into reservation_record
      from public.inventory_reservations
     where id = item_record.reservation_id
     for update;

    if not found
       or reservation_record.store_id <> sale_record.store_id
       or reservation_record.inventory_id <> item_record.inventory_id
       or reservation_record.status <> 'active'
       or reservation_record.expires_at <= observed_at then
      raise exception using errcode = '23514',
        message = 'a sale device reservation is invalid or expired';
    end if;

    update public.inventory_reservations
       set status = 'fulfilled',
           fulfilled_at = observed_at
     where id = reservation_record.id;

    update public.store_inventory
       set status = 'sold',
           sold_at = observed_at
     where id = inventory_record.id;

    insert into public.inventory_movements (
      store_id,
      inventory_id,
      movement_type,
      from_status,
      to_status,
      reference_type,
      reference_id,
      performed_by_membership_id,
      notes,
      occurred_at
    )
    values (
      sale_record.store_id,
      inventory_record.id,
      'sold',
      'reserved',
      'sold',
      'sale',
      p_sale_id,
      caller_membership_id,
      'Device sold as part of confirmed sale',
      observed_at
    );

    insert into public.audit_events (
      store_id,
      actor_membership_id,
      event_type,
      entity_type,
      entity_id,
      event_data,
      occurred_at
    )
    values (
      sale_record.store_id,
      caller_membership_id,
      'inventory.sold',
      'store_inventory',
      inventory_record.id,
      jsonb_build_object(
        'sale_id', p_sale_id,
        'sale_item_id', item_record.id,
        'payment_id', new_payment_id
      ),
      observed_at
    );
  end loop;

  update public.sales
     set status = 'completed',
         completed_at = observed_at
   where id = p_sale_id;

  insert into public.audit_events (
    store_id,
    actor_membership_id,
    event_type,
    entity_type,
    entity_id,
    event_data,
    occurred_at
  )
  values (
    sale_record.store_id,
    caller_membership_id,
    'payment.manually_confirmed',
    'sale',
    p_sale_id,
    jsonb_build_object(
      'payment_id', new_payment_id,
      'amount_pesewas', sale_record.total_pesewas,
      'payment_method', p_payment_method,
      'item_count', active_item_count
    ),
    observed_at
  );

  insert into public.audit_events (
    store_id,
    actor_membership_id,
    event_type,
    entity_type,
    entity_id,
    event_data,
    occurred_at
  )
  values (
    sale_record.store_id,
    caller_membership_id,
    'sale.completed',
    'sale',
    p_sale_id,
    jsonb_build_object(
      'payment_id', new_payment_id,
      'item_count', active_item_count,
      'total_pesewas', sale_record.total_pesewas
    ),
    observed_at
  );

  return query
    select p_sale_id,
           new_payment_id,
           sale_record.total_pesewas,
           'completed'::text;
end;
$$;

commit;
